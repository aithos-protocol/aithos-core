      "value": "x/gateway/state.json",
      "expected": "accepted"
    },
    {
      "id": "another-consumer-rides-x-the-same-way",
      "input_kind": "store_key",
      "value": "x/runner/state.json",
      "expected": "accepted"
    },
    {
      "id": "legacy-state-key-removed",
      "input_kind": "store_key",
      "value": "gateway/state.json",
      "expected": "rejected"
    },
    {
      "id": "legacy-keys-key-removed",
      "input_kind": "store_key",
      "value": "gateway/keys.json",
      "expected": "rejected"
    },
    {
      "id": "no-bare-consumer-directory",
      "input_kind": "store_key",
      "value": "gateway/anything.json",
      "expected": "rejected"
    },
    {
      "id": "x-namespace-stays-closed-at-depth-1",
      "input_kind": "store_key",
      "value": "x/state.json",
      "expected": "rejected"
    }
  ]
